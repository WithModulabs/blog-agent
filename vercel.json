{
    "version": 2,
    "builds": [
        {
            "src": "backand/api/index.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/backand/api/index.py"
        }
    ]
}